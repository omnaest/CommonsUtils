<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.omnaest.utils</groupId>
	<artifactId>CommonsUtils</artifactId>

	<parent>
		<groupId>org.omnaest.utils</groupId>
		<artifactId>CommonsParent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<properties>
		<!-- Publishing opt-in: CommonsParent defaults both to true (fail-closed). This module is
		     already published to the Central Portal snapshot repository, so it opts back in. -->
		<maven.deploy.skip>false</maven.deploy.skip>
		<central.skipPublishing>false</central.skipPublishing>
	</properties>

	<licenses>
		<license>
			<name>The Apache Software License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>omnaest</id>
			<name>Danny Kunz</name>
			<email>awonderland6@googlemail.com</email>
		</developer>
	</developers>

	<repositories>
		<repository>
			<id>ossrh</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>

	<dependencies>
		<dependency>
			<groupId>org.omnaest.utils</groupId>
			<artifactId>CommonsTest</artifactId>
			<version>0.0.1-SNAPSHOT</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.omnaest.utils</groupId>
			<artifactId>CommonsLog</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>org.omnaest.utils</groupId>
			<artifactId>CommonsLangAndIO</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>org.omnaest.utils</groupId>
			<artifactId>CommonsJSONAndXML</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>org.omnaest.utils</groupId>
			<artifactId>CommonsRepository</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<!-- plan-208 Cliff B: CommonsStyleAnnotations is a PRIVATE, UNPUBLISHED module (see its own pom.xml -
			maven.deploy.skip/skipPublishing/central.skipPublishing all true, plus a plugin-level override). This
			module (CommonsUtils) IS published to the Central Portal snapshot repository (see the properties
			above). `provided` scope is not transitive, so no consumer of CommonsUtils ever resolves this
			dependency transitively - but the published CommonsUtils POM will nonetheless contain a reference to
			an artifact that does not exist on any public repository. This is a fact for the user to see before
			deciding whether to push/publish this change, not a defect to fix here. -->
		<dependency>
			<groupId>org.omnaest.utils</groupId>
			<artifactId>CommonsStyleAnnotations</artifactId>
			<version>0.0.1-SNAPSHOT</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.omnaest.utils</groupId>
			<artifactId>CommonsStyleSupport</artifactId>
			<version>0.0.1-SNAPSHOT</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>